# -----------------------------------------------------------------------------
# Core Infrastructure Connections
# -----------------------------------------------------------------------------
APP_ENV=development
LISTEN_ADDR=:8080

REDIS_ADDR=localhost:6379
REDIS_PASS=openwar-redis-pass

NATS_URL=nats://localhost:4222
DATABASE_URL=postgres://openwar:openwar@localhost:5432/openwar
BACKEND_URL=http://localhost:9001

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# JWT_SECRET must be at least 32 characters long.
JWT_SECRET=openwar-super-secret-key-32-bytes-long
ALLOWED_ORIGINS=http://localhost,http://localhost:3000

# -----------------------------------------------------------------------------
# Flash Sale Tuning
# -----------------------------------------------------------------------------
ADMISSION_EVENT=flash-sale-001
ADMISSION_RATE=100
INVENTORY_SHARDS=32

PAYMENT_WINDOW=15m
RESERVATION_TTL=25m
